# Copy to `.env` (git-ignored) and fill in what you use. The names are what config.py looks up.

# ---- LLM providers (at least one) — the vendors' own keys. Every call goes to the vendor's
# own endpoint, pinned in providers/llm.py (a stray *_BASE_URL in the environment is ignored). ----
OA_OPENAI_KEY=                 # OpenAI (also used for skill-retrieval embeddings)
Anthropic_KEY=                 # Anthropic
Gemini_KEY=                    # Google Gemini
Qwen_KEY=                      # Alibaba DashScope (its own OpenAI-compatible API)
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1   # DashScope REGION
Meta_KEY=                      # Meta (api.meta.ai)
# The open computer-use agents, self-hosted with vLLM (`vllm serve ... --port 8080`); the key
# is not checked (any value) — providers/evocua.py and providers/opencua.py speak their formats.
# EVOCUA_BASE_URL=http://127.0.0.1:8080/v1     # -p evocua  (-m = the served model name)
# OPENCUA_BASE_URL=http://127.0.0.1:8080/v1    # -p opencua

# ---- run defaults (all overridable on the CLI) ----
LLM_PROVIDER=anthropic          # openai | anthropic | gemini | qwen | meta
LLM_MODEL=                      # empty = the provider's default in config._PROVIDERS
LLM_CACHE=1

# ---- isolated-VM bench (bench_runner/vm) ----
VM_VMX=C:\Users\<you>\Documents\Virtual Machines\BIMArena-Win11-v1\BIMArena-Win11-v1.vmx
VM_PASSWORD=                    # the VM's encryption password (vmrun -vp); empty if unencrypted
VM_GUEST_USER=                  # the Windows account logged in on the guest desktop
VM_GUEST_PASSWORD=
VM_SNAPSHOT=S1-Revit-Exp-Start  # the running-state snapshot every case starts from (prep_vm.py
                                # takes S1-Revit-Exp-Start / S2-Archicad-Exp-Start; --snapshot overrides)
VM_TOOL=revit                   # which application the snapshot has open: revit | archicad
VM_SHARE=Z:                     # where the guest sees THIS repo (VMware shared folder, mapped drive)
VM_GUEST_PYTHON=C:\bench\venv\Scripts\python.exe   # a venv built IN the guest, outside the share
VM_WORKSPACE=C:\bench\workspace # guest-local copies of each case's pristine dir
# VM_WORKERS=<parent.vmx>,<A.vmx>,<B.vmx>   # optional: guests to drive IN PARALLEL (run --workers)
# ---- GUI coordinate handling: AUTOMATIC PER MODEL (authoring_framework/tools/gui/profile.py) ----
# Switching -p/-m is all it takes: the model id picks the coordinate frame (pixels for GPT /
# Claude, the 0-1000 grid for Gemini / Qwen / Meta / EvoCUA / OpenCUA) and the matching wording in the
# tool declarations. Screenshots go out at the desktop's 1920x1080, except for Claude: Anthropic
# resizes larger images server-side, so the Claude rule sends 1344x756 and maps the clicks
# back (locked — the knobs below may only tighten it). Leave the four knobs UNSET unless you are
# running a deliberate ablation; each run records what it resolved (memory.json gui_profile,
# stats.gui, and the score's run.gui). A model no rule knows prints a warning — verify it with
#   python -m authoring_framework.tools.gui.calibrate -p <provider> -m <model>
# GUI_COORD_FRAME=pixels|norm1000     # force the DECODE frame
# GUI_COORD_WORDING=pixels|norm1000   # force the WORDING (default: follows the frame)
# GUI_MAX_IMG_EDGE=0                  # long-edge cap in px; 0 = none (the default)
# MAX_IMG_PIXELS=0                    # total-pixel cap; 0 = none (the default)
