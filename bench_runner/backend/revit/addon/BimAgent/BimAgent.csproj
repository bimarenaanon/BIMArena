<Project Sdk="Microsoft.NET.Sdk">

  <!-- Revit 2027 runs on .NET 10. The add-in references the Revit API DLLs from the install and
       serves the bim-agent HTTP routes the Python backend (revit/client.py) expects.
       Build:   dotnet build -c Debug   (or open in Visual Studio)
       Deploy:  the post-build target copies BimAgent.dll + BimAgent.addin into the per-user
                Revit Addins folder (no admin needed); restart Revit to load it. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>

    <RevitVersion>2027</RevitVersion>
    <RevitDir>C:\Program Files\Autodesk\Revit $(RevitVersion)\</RevitDir>
    <AddinsDir>$(APPDATA)\Autodesk\Revit\Addins\$(RevitVersion)\</AddinsDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Revit API assemblies — referenced from the install, NOT copied to output (Private=false). -->
    <Reference Include="RevitAPI">
      <HintPath>$(RevitDir)RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitDir)RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Deploy to the per-user Revit Addins folder after each build. The .addin's <Assembly> is the
       bare DLL name, resolved relative to the manifest location, so both must sit together here.
       The whole output folder is copied. NOTE: the copy FAILS while
       Revit is running — it holds BimAgent.dll loaded; close Revit before rebuilding. -->
  <Target Name="DeployAddin" AfterTargets="Build">
    <ItemGroup>
      <DeployFiles Include="$(TargetDir)**\*.*" />
    </ItemGroup>
    <MakeDir Directories="$(AddinsDir)" />
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(AddinsDir)%(RecursiveDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\BimAgent.addin" DestinationFolder="$(AddinsDir)" />
    <Message Importance="high" Text="Deployed BimAgent to $(AddinsDir)" />
  </Target>

</Project>
