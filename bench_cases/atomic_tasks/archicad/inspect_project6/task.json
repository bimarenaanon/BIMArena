{
  "id": "inspect_project6",
  "legacy_id": "select_elements2",
  "atom": "select_elements",
  "category": "Query & Selection",
  "authoring_tool": "ArchiCAD",
  "required_capabilities": "Inspect Project (×1)",
  "instruction": "Select the floor slab and then the zone on the storey you have open, then read the selection back and REPORT the slab's composite and the zone's name and number. Give your answer as ONE LINE PER ITEM, in the form \"<label>: <value>\", nothing else on the line, using the labels composite, zone name and zone number. Change nothing else.",
  "input": {
    "drawing": "text-only"
  },
  "expected_result": {
    "preserve": [
      "walls",
      "doors",
      "windows",
      "slabs",
      "rooms"
    ],
    "exact_counts": {
      "walls": 5,
      "slabs": 1,
      "rooms": 1
    },
    "answer_items": [
      {
        "label": "composite",
        "min": 1,
        "must_match": [
          [
            "concrete floor with 10mm tile"
          ]
        ]
      },
      {
        "label": "zone name",
        "min": 1,
        "must_match": [
          [
            "office"
          ]
        ]
      },
      {
        "label": "zone number",
        "min": 1,
        "must_match": [
          [
            "01",
            "1"
          ]
        ]
      }
    ]
  },
  "env_template": "base",
  "env": {
    "files": [
      {
        "filename": "",
        "filepath": "./bench_cases/atomic_tasks/archicad/inspect_project6/env"
      }
    ]
  }
}
