{
  "id": "inspect_project1",
  "legacy_id": "get_selection1",
  "atom": "get_selection",
  "category": "Query & Selection",
  "authoring_tool": "Revit",
  "required_capabilities": "Inspect Project (×1)",
  "instruction": "Select the four EXTERIOR walls, then read the selection back and REPORT the wall type they are built from and their thickness in millimetres. Answer in the form \"<label>: <value>\", one line each, using the labels type and width.",
  "input": {
    "drawing": "text-only"
  },
  "expected_result": {
    "preserve": [
      "walls",
      "doors",
      "windows",
      "slabs",
      "rooms"
    ],
    "answer_items": [
      {
        "label": "type",
        "min": 1,
        "must_match": [
          [
            "Exterior - Brick on Mtl. Stud"
          ]
        ]
      }
    ],
    "answer_values": {
      "width": {
        "value": 350,
        "tol": 1,
        "unit": "mm"
      }
    }
  },
  "env_template": "base",
  "env": {
    "files": [
      {
        "filename": "",
        "filepath": "./bench_cases/atomic_tasks/revit/inspect_project1/env"
      }
    ]
  }
}
